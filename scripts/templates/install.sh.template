#!/bin/bash
# ============================================================
#  PS 图层导出工具 - macOS 自动安装脚本
#  版本: __VERSION__
#  用法:
#    终端: bash 本文件  或  ./本文件
#    Finder: 双击 .command 副本（自动打开终端运行）
#
#  说明: 本文件为自解压脚本，__PAYLOAD_BELOW__ 标记行之后
#        为 base64 编码的 tar.gz 插件数据。
# ============================================================

set -u
set -o pipefail

EXTENSION_ID="com.ps.export.layer.tool"
PAYLOAD_MARKER="__PAYLOAD_BELOW__"

# ---------- 输出辅助 ----------
info() { echo "[信息] $*"; }
ok()   { echo "[成功] $*"; }
warn() { echo "[警告] $*"; }
err()  { echo "[错误] $*" >&2; }

# ---------- 自解压载荷 ----------
PAYLOAD_LINE=$(awk -v m="$PAYLOAD_MARKER" '$0 == m { print NR; exit }' "$0")
if [ -z "$PAYLOAD_LINE" ]; then
  err "安装包数据缺失，请重新下载。"
  exit 1
fi

TMP_DIR=$(mktemp -d) || { err "无法创建临时目录。"; exit 1; }
trap 'rm -rf "$TMP_DIR"' EXIT

if ! tail -n +$((PAYLOAD_LINE + 1)) "$0" | base64 -d | tar xzf - -C "$TMP_DIR"; then
  err "安装包数据解压失败，请重新下载。"
  exit 1
fi

SRC_DIR="$TMP_DIR/$EXTENSION_ID"
for d in CSXS dist doc; do
  if [ ! -d "$SRC_DIR/$d" ]; then
    err "安装包缺少 $d/ 目录，请重新下载。"
    exit 1
  fi
done

# ---------- 确定安装目标 ----------
if [ -z "${HOME:-}" ]; then
  err "无法确定 HOME 目录。"
  exit 1
fi
EXTENSIONS_DIR="$HOME/Library/Application Support/Adobe/CEP/extensions"
TARGET_DIR="$EXTENSIONS_DIR/$EXTENSION_ID"

# ---------- 工具函数 ----------
# 备份用户预设（dist/lib/presets/ 整目录，含 default.json）
backup_user_presets() {
  local src="$1" dest="$2"
  if [ -d "$src/dist/lib/presets" ]; then
    mkdir -p "$dest"
    cp -R "$src/dist/lib/presets" "$dest/presets"
  fi
}

# 恢复用户预设到目标 dist/lib/（覆盖安装包内置的 default.json）
restore_user_presets() {
  local src="$1" dest="$2"
  if [ -d "$src/presets" ]; then
    mkdir -p "$dest/dist/lib"
    cp -R "$src/presets" "$dest/dist/lib/"
  fi
}

# ---------- 检测 Photoshop（仅提示） ----------
PS_COUNT=$(ls -d /Applications/Adobe\ Photoshop* 2>/dev/null | wc -l | tr -d ' ')
if [ "$PS_COUNT" -gt 0 ]; then
  info "检测到 $PS_COUNT 个 Photoshop 安装"
else
  warn "未检测到 Photoshop（仍将安装插件本体）"
fi

# ---------- 处理已存在的安装 ----------
BACKUP_TMP=""
if [ -e "$TARGET_DIR" ] || [ -L "$TARGET_DIR" ]; then
  if [ -L "$TARGET_DIR" ]; then
    info "检测到目录链接，正在备份用户预设并移除链接..."
  else
    info "检测到已安装的版本，正在备份用户预设并移除..."
  fi
  BACKUP_TMP=$(mktemp -d) || { err "无法创建临时目录。"; exit 1; }
  backup_user_presets "$TARGET_DIR" "$BACKUP_TMP"
  rm -rf "$TARGET_DIR"
fi

# 卸载程序留下的用户预设备份目录（Windows/macOS 卸载程序共用同一布局）
USER_BACKUP_DIR="$EXTENSIONS_DIR/${EXTENSION_ID}_user_files"

# ---------- 复制插件文件 ----------
if ! mkdir -p "$TARGET_DIR"; then
  err "无法创建扩展目录: $TARGET_DIR"
  exit 1
fi

for d in CSXS dist doc; do
  if ! cp -R "$SRC_DIR/$d" "$TARGET_DIR/$d"; then
    err "复制 $d/ 失败，请检查目录权限。"
    exit 1
  fi
done
ok "插件文件复制完成"

# ---------- 恢复用户预设（覆盖安装包内置的 default.json） ----------
if [ -n "$BACKUP_TMP" ]; then
  if [ -d "$BACKUP_TMP/presets" ]; then
    restore_user_presets "$BACKUP_TMP" "$TARGET_DIR"
    info "已恢复原安装的用户预设"
  fi
  rm -rf "$BACKUP_TMP"
  BACKUP_TMP=""
fi

# 从卸载备份目录恢复（安装器与卸载器共用 ${EXTENSION_ID}_user_files）
if [ -d "$USER_BACKUP_DIR" ]; then
  if [ -d "$USER_BACKUP_DIR/presets" ]; then
    restore_user_presets "$USER_BACKUP_DIR" "$TARGET_DIR"
    ok "已从卸载备份恢复用户预设"
  fi
  rm -rf "$USER_BACKUP_DIR"
  info "已删除备份目录"
fi

# 注意：此处不删除安装包内置的 dist/lib/presets/default.json。
# 面板首次加载内置预设（22 个）依赖该文件，用户修改过的预设已在上面恢复时覆盖。

# ---------- 开启 CEP 调试模式 ----------
for ver in 6 7 8 9 10 11 12; do
  defaults write "com.adobe.CSXS.$ver" PlayerDebugMode -integer 1 2>/dev/null
done
ok "已开启 CEP 调试模式 (CSXS 6-12)"

# ---------- 完成 ----------
echo ""
echo "╔══════════════════════════════════════════════╗"
echo "║                安装完成！                    ║"
echo "╠══════════════════════════════════════════════╣"
echo "║  请重启 Photoshop，然后在菜单中找到：        ║"
echo "║  窗口 → 扩展 → PS 图层导出工具               ║"
echo "╚══════════════════════════════════════════════╝"
echo ""
echo "按回车键退出..."
if [ -t 0 ]; then
  read
fi
exit 0

__PAYLOAD_BELOW__
